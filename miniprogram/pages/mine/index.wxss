.profile-card{background:linear-gradient(125deg,#fff,#eef4ff);border:1rpx solid #e3eaf6;padding:34rpx 28rpx;border-radius:28rpx;margin:12rpx 0 30rpx}.profile-text{flex:1;min-width:0}.profile-name{font-size:34rpx;font-weight:650;margin-bottom:10rpx;word-break:break-all}.avatar-button{padding:0;position:relative;background:none;flex:none;overflow:hidden;width:112rpx;height:112rpx;border-radius:50%}.avatar-button image,.avatar-placeholder{width:112rpx;height:112rpx;border-radius:50%}.avatar-placeholder{background:#dae6ff;color:#5080d7;display:flex;align-items:center;justify-content:center;font-size:46rpx;flex-shrink:0}.avatar-edit{position:absolute;bottom:0;background:#24478088;color:white;font-size:20rpx;left:0;right:0;text-align:center}.login{margin-top:30rpx}.profile-edit{font-size:24rpx;color:#5380ce;margin-top:24rpx}.menu{background:white;border:1rpx solid #e9edf4;border-radius:24rpx;padding:0 28rpx}.menu-item{display:flex;justify-content:space-between;align-items:center;gap:16rpx;padding:30rpx 0;border-bottom:1rpx solid #eef1f6}.menu-item:last-child{border-bottom:0}.menu-item .heading{margin-bottom:8rpx}.count{color:#8b9ab1;font-size:25rpx;white-space:nowrap}.logout{margin-top:40rpx;background:transparent;color:#8995a6}
