# Copy to .env at the project root. Authentication is not implemented yet.
HOST=127.0.0.1
PORT=3001
# Relative to project root
DATA_DIR=./data/postgres
WEB_ORIGIN=http://localhost:5173
# Optional: backend-only; alternatively run node scripts/configure-deepseek.mjs
# DEEPSEEK_API_KEY=

# Internal testing only: fixed code 666666, never proves phone ownership.
# Keep reverse-proxy access protection enabled while testing.
AUTH_TEST_MODE=true
# Set to your actual phone before rollout; archived media/videos migrate to this account.
AUTH_ADMIN_PHONE=
