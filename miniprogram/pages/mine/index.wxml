<view class="page mine">
 <view class="mine-title">我的工作台</view>
 <view class="profile-card">
  <view class="profile-header">
   <view class="avatar-area"><button wx:if="{{loggedIn}}" class="avatar-button" size="mini" open-type="chooseAvatar" bindchooseavatar="avatar" disabled="{{busy}}"><image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFit"/><view wx:else class="avatar-placeholder">优</view></button><view wx:else class="avatar-placeholder">优</view><text wx:if="{{loggedIn}}" class="avatar-caption">更换头像</text></view>
   <view class="profile-text"><input wx:if="{{loggedIn ? !nickname : false}}" id="wechat-nickname" class="profile-name nickname-inline" type="nickname" value="{{nickname}}" placeholder="点击获取微信昵称" placeholder-class="nickname-placeholder" maxlength="32" disabled="{{nicknameSaving}}" bindinput="nicknameChanged" bindblur="nicknameChanged" bindnicknamereview="nicknameReviewed"/><view wx:elif="{{loggedIn}}" class="profile-name">{{nickname}}</view><view wx:else class="profile-name">欢迎来到达人优选</view><view class="profile-description">{{loggedIn?'让每次探店，都有好发现':'发现好券，收藏你的探店灵感'}}</view></view>
  </view>
  <button wx:if="{{!loggedIn}}" class="primary login" loading="{{busy}}" disabled="{{busy}}" bindtap="login">微信登录</button>
 </view>
 <view wx:if="{{error}}" class="error" bindtap="retry">{{error}} · 点击重试<view wx:if="{{errorDetail}}" class="request-error-detail"><text selectable="{{true}}">{{errorDetail}}</text></view></view>
 <view class="menu-title">我的偏好与动态</view>
 <view class="menu">
  <view class="menu-item" data-url="/pages/brands/index?mode=subscriptions" bindtap="open"><view class="menu-icon blue">订</view><view class="menu-copy"><view class="heading">品牌订阅</view><view class="muted">订阅管理与微信提醒</view></view><text class="count">{{subscriptions}}</text><text class="chevron">›</text></view>
  <view class="menu-item" data-url="/pages/messages/index" bindtap="open"><view class="menu-icon violet">信</view><view class="menu-copy"><view class="heading">消息中心</view><view class="muted">查看品牌最新动态</view></view><text class="unread" wx:if="{{unread}}">{{unread}}</text><text class="chevron">›</text></view>
  <view class="menu-item" data-url="/pages/brands/index?mode=blacklist" bindtap="open"><view class="menu-icon gray">隐</view><view class="menu-copy"><view class="heading">品牌黑名单</view><view class="muted">减少不感兴趣的推荐</view></view><text class="count">{{blacklist}}</text><text class="chevron">›</text></view>
 </view>
 <button wx:if="{{loggedIn}}" class="logout" bindtap="logout">退出登录</button>
</view>
