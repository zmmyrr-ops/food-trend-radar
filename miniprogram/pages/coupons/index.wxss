.coupon-page{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}.discovery-header{background:#fff;padding:24rpx 28rpx 0;border-bottom:1rpx solid #e9edf4}.discovery-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx}.discovery-name{font-size:38rpx;font-weight:650;letter-spacing:1rpx}.city-pill{font-size:22rpx;color:#71809a;background:#f2f5fa;border-radius:20rpx;padding:7rpx 18rpx}.channel-control{display:flex;gap:8rpx;width:360rpx;background:#f0f3f8;padding:6rpx;border-radius:18rpx;box-sizing:border-box;margin-bottom:24rpx}.channel-item{flex:1;text-align:center;font-size:26rpx;line-height:60rpx;color:#7b879b;border-radius:13rpx}.channel-item.selected{background:#fff;color:#356ce0;font-weight:600;box-shadow:0 2rpx 6rpx #1f37510a}.search-box{display:flex;align-items:center;gap:12rpx;background:#f4f6fa;border-radius:16rpx;padding:0 22rpx;height:80rpx;box-sizing:border-box}.search-symbol{font-size:42rpx;color:#8d9bb1}.search-box input{flex:1;min-width:0;height:80rpx;font-size:25rpx}.search-placeholder{color:#98a4b7}.coupon-view-scroll{display:block;width:100%;height:100rpx;white-space:nowrap;overflow:hidden}.coupon-view-track{display:inline-flex;align-items:center;height:100rpx;box-sizing:border-box}.coupon-view{display:inline-flex;position:relative;align-items:center;justify-content:center;height:100rpx;margin-right:34rpx;flex-shrink:0;font-size:26rpx;line-height:1;color:#7c899d}.coupon-view:last-child{margin-right:0}.coupon-view.selected{color:#2b63cd;font-weight:650}.view-indicator{position:absolute;bottom:0;width:32rpx;height:5rpx;background:#3975e9;border-radius:6rpx}.coupon-content{padding:0 24rpx}.filter-bar{display:flex;align-items:center;gap:26rpx;min-height:84rpx;flex-wrap:wrap;padding:10rpx 2rpx;box-sizing:border-box;color:#627089;font-size:23rpx}.result-total{margin-left:auto;color:#a0aabb;font-size:22rpx}.coupon-card{padding:26rpx;background:#fff;border:1rpx solid #e7ecf4;border-radius:22rpx;margin:0 0 20rpx;box-shadow:0 3rpx 10rpx #20375d03}.coupon-brand{color:#73829a;font-size:24rpx;max-width:85%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.coupon-title{font-size:29rpx;line-height:1.55;font-weight:600;margin:16rpx 0 22rpx;color:#26374f}.price{font-size:44rpx;line-height:1.2;font-weight:700;color:#306edb;margin:0 0 16rpx}.original{font-size:22rpx;color:#a2acbb;text-decoration:line-through;font-weight:400;margin-left:12rpx}.score-block{display:flex;flex-direction:column;align-items:flex-end;gap:3rpx}.score-number{font-size:32rpx;font-weight:650;color:#465878}.score-label{font-size:20rpx;color:#9aa5b6}.coupon-meta{display:flex;justify-content:space-between;color:#8895a9;font-size:22rpx;line-height:36rpx}.coupon-actions{display:flex;align-items:center;gap:18rpx;border-top:1rpx solid #f0f3f7;margin-top:20rpx;padding-top:20rpx}.coupon-actions button{margin:0;line-height:1.4;font-size:23rpx;padding:14rpx 22rpx;border-radius:12rpx}.coupon-actions .follow-brand{background:#edf3ff;color:#396bc1}.coupon-actions .mute-brand{background:transparent;color:#929dae;margin-left:auto;padding-right:0}.sheet-scroll{height:55vh}
