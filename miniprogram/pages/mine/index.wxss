.mine{padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}.mine-title{font-size:38rpx;font-weight:650;margin:0 0 28rpx}.profile-card{background:#fff;border:1rpx solid #e5ebf5;padding:30rpx;border-radius:26rpx;box-shadow:0 8rpx 28rpx #293f6f04}.profile-header{display:flex;align-items:center;gap:26rpx}.avatar-area{width:110rpx;flex-shrink:0;text-align:center}.avatar-button{padding:0;margin:0;background:transparent;overflow:hidden;width:108rpx;height:108rpx;border-radius:32rpx;line-height:1;min-height:0}.avatar-button image,.avatar-placeholder{display:block;width:108rpx;height:108rpx;border-radius:32rpx}.avatar-placeholder{background:#edf3ff;color:#6089d5;line-height:108rpx;text-align:center;font-size:42rpx;font-weight:650}.avatar-caption{display:block;font-size:20rpx;color:#8094b5;margin-top:10rpx}.profile-text{flex:1;min-width:0}.profile-name{font-size:33rpx;font-weight:650;line-height:1.4;word-break:break-all;color:#283950}.profile-description{color:#98a3b4;font-size:23rpx;line-height:1.5;margin-top:12rpx}.login{margin-top:28rpx;border-radius:16rpx;font-size:27rpx;padding:21rpx}.menu-title{font-size:23rpx;color:#94a1b6;margin:32rpx 6rpx 16rpx}.menu{background:#fff;border:1rpx solid #e9edf4;border-radius:24rpx;padding:0 24rpx}.menu-item{display:flex;align-items:center;gap:20rpx;padding:28rpx 0;border-bottom:1rpx solid #f0f3f7}.menu-item:last-child{border-bottom:0}.menu-icon{width:66rpx;height:66rpx;line-height:66rpx;text-align:center;border-radius:19rpx;font-size:26rpx;flex-shrink:0}.blue{background:#edf3ff;color:#5b81c8}.violet{background:#f2f0ff;color:#9382c1}.gray{background:#eff2f6;color:#8b9ab0}.menu-copy{flex:1;min-width:0}.menu-item .heading{font-size:28rpx;font-weight:550;margin-bottom:7rpx}.menu-item .muted{font-size:22rpx;color:#9aa6b8}.count,.chevron{color:#a7b2c3;font-size:25rpx}.chevron{font-size:36rpx}.unread{font-size:21rpx;color:#fff;background:#638be1;padding:4rpx 12rpx;border-radius:18rpx}.logout{margin:32rpx 0 0;background:transparent;color:#9ba6b8;font-size:24rpx;padding:20rpx}

.profile-card{position:relative;padding:28rpx}.profile-header{gap:22rpx}.avatar-area{width:96rpx}.avatar-button,.avatar-button image,.avatar-placeholder{width:96rpx;height:96rpx;border-radius:18rpx;line-height:96rpx}.avatar-caption{font-size:19rpx;margin-top:8rpx}.profile-name{font-size:32rpx}.profile-description{margin-top:8rpx;font-size:22rpx}.nickname-inline{width:100%;height:56rpx;line-height:56rpx;padding:0;border:0;background:transparent}.nickname-placeholder{color:#7187ab;font-size:28rpx;font-weight:500}

.avatar-button{box-sizing:border-box;padding:6rpx!important;background:#f4f7fc}.avatar-button image{width:84rpx;height:84rpx;border-radius:12rpx}.avatar-button .avatar-placeholder{width:84rpx;height:84rpx;line-height:84rpx;border-radius:12rpx}

.profile-header{align-items:center}.avatar-area{flex:0 0 96rpx;max-width:96rpx}.profile-card .avatar-button[size="mini"]{display:flex;align-items:center;justify-content:center;width:96rpx!important;min-width:96rpx;max-width:96rpx;height:96rpx!important;padding:6rpx!important;margin:0!important;box-sizing:border-box;flex-shrink:0}.profile-text{overflow:hidden}.profile-description{line-height:1.5}
