<view class="page"><view class="row"><view class="title">订阅消息</view><text class="badge" wx:if="{{unread}}">{{unread}} 条未读</text></view><view class="actions"><button bindtap="readAll" disabled="{{!unread}}">本页已读</button></view><view wx:if="{{error}}" class="error" bindtap="retry">{{error}} · 重试</view><view wx:for="{{items}}" wx:key="id" class="card" data-index="{{index}}" bindtap="open"><view class="row"><text class="heading">{{item.brand_name}}</text><text class="badge">{{item.kind==='new'?'新上券':'热度飙升'}}</text></view><view class="rule">{{item.title}}</view><view class="row muted"><text>{{item.read_at?'已读':'未读'}}</text><text class="link">查看该品牌的券 ›</text></view></view><view wx:if="{{loading}}" class="empty">加载中…</view><view wx:elif="{{!items.length&&!error}}" class="empty">暂无消息，先去“我的品牌”订阅感兴趣的店。</view></view>
