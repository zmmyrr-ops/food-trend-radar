<view class="coupon-page">
 <view class="discovery-header">
  <view class="discovery-top"><view class="discovery-name">今天探点好店</view><text class="city-pill">上海</text></view>
  <view class="channel-control"><view class="channel-item {{channel==='food'?'selected':''}}" data-id="food" bindtap="channel">美食好券</view><view class="channel-item {{channel==='leisure'?'selected':''}}" data-id="leisure" bindtap="channel">游玩灵感</view></view>
  <view class="search-box"><text class="search-symbol">⌕</text><input placeholder="搜索品牌、店铺或优惠券" placeholder-class="search-placeholder" value="{{search}}" bindinput="search" confirm-type="search"/></view>
  <scroll-view class="coupon-view-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}"><view class="coupon-view-track"><view wx:for="{{views}}" wx:key="id" class="coupon-view {{view===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="view">{{item.name}}<view wx:if="{{view===item.id}}" class="view-indicator"/></view></view></scroll-view>
 </view>
 <view class="coupon-content">
 <view class="filter-bar"><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><text>{{categories[categoryIndex]}} ▾</text></picker><picker range="{{sorts}}" value="{{sortIndex}}" bindchange="sort"><text>{{sorts[sortIndex]}} ▾</text></picker><text class="result-total">{{total}} 张券</text></view>
 <view wx:if="{{brand_id}}" class="chip" bindtap="clearBrand">当前仅看所选品牌 ×</view>
 <view wx:if="{{!loggedIn}}" class="card"><view class="heading">登录后发现适合你的好券</view><view class="muted rule">查看优先券、新上与热度增长，订阅感兴趣的品牌。</view><button class="primary" bindtap="goLogin">去微信登录</button></view>
 <view wx:if="{{error}}" class="error" bindtap="retry">{{error}} · 点击重试</view>
 <view wx:for="{{items}}" wx:key="key" class="coupon-card" data-index="{{index}}" bindtap="detail">
  <view class="row"><view class="coupon-brand-heading"><image wx:if="{{!item.iconFailed}}" class="brand-logo" src="{{item.iconUrl}}" mode="aspectFit" lazy-load="{{true}}" data-brand="{{item.brand_id}}" binderror="iconError"/><view wx:else class="brand-logo brand-logo-fallback">{{item.brandInitial}}</view><text class="coupon-brand">{{item.brand_name}}</text></view><text wx:if="{{item.is_new}}" class="badge">新上</text></view>
  <view class="coupon-title">{{item.title}}</view><view class="row"><view class="price">¥{{item.price}}<text class="original" wx:if="{{item.origin_price_fen}}">¥{{item.origin}}</text></view><view class="score-block"><text class="score-number">{{item.score}}</text><text class="score-label">优先分</text></view></view>
  <view class="coupon-meta"><text>热度增速 {{item.heat_index===null?'待积累':item.heat_index+'/100'}}</text><text>使用规则 ›</text></view>
  <view class="coupon-actions"><button class="follow-brand {{item.subscribed?'is-added':''}}" disabled="{{!preferencesReady || item.subscribed || item.subscribing}}" loading="{{item.subscribing}}" data-brand="{{item.brand_id}}" catchtap="subscribe">{{item.subscribed?'已订阅':'订阅品牌'}}</button><button class="mute-brand {{item.blocked?'is-added':''}}" disabled="{{!preferencesReady || item.blocked || item.blocking}}" loading="{{item.blocking}}" data-brand="{{item.brand_id}}" catchtap="block">{{item.blocked?'已拉黑':'不感兴趣'}}</button></view>
 </view>
 <view class="empty" wx:if="{{loading}}">正在加载…</view><view class="empty" wx:elif="{{loggedIn && !items.length && !error}}">暂无符合条件的券</view><view class="empty" wx:elif="{{items.length>=total && items.length}}">已展示全部结果</view>
</view></view>
<view wx:if="{{detail}}" class="modal" bindtap="close"><view class="sheet" catchtap="noop"><view class="row"><text class="heading">使用规则</text><button size="mini" bindtap="close">关闭</button></view><scroll-view scroll-y class="sheet-scroll"><view class="rule heading">{{detail.title}}</view><view wx:if="{{detail.shop}}" class="rule"><view>{{detail.shop.name}}</view><view class="muted">{{detail.shop.address}}</view></view><view wx:if="{{detail.loading}}">加载中…</view><view wx:elif="{{detail.error}}">{{detail.error}}</view><view wx:elif="{{!detail.rules.length}}" class="muted">暂无附加使用条件，请购买前核实。</view><view wx:for="{{detail.rules}}" wx:key="key" class="rule"><view>{{item.name}}</view><view class="muted" wx:for="{{item.value}}" wx:for-item="entry" wx:key="index">{{entry.content}}</view></view></scroll-view></view></view>
