.coupon-page{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}.discovery-header{background:#fff;padding:24rpx 28rpx 0;border-bottom:1rpx solid #e9edf4}.discovery-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx}.discovery-name{font-size:38rpx;font-weight:650;letter-spacing:1rpx}.city-pill{font-size:22rpx;color:#71809a;background:#f2f5fa;border-radius:20rpx;padding:7rpx 18rpx}.channel-control{display:flex;gap:8rpx;width:360rpx;background:#f0f3f8;padding:6rpx;border-radius:18rpx;box-sizing:border-box;margin-bottom:24rpx}.channel-item{flex:1;text-align:center;font-size:26rpx;line-height:60rpx;color:#7b879b;border-radius:13rpx}.channel-item.selected{background:#fff;color:#356ce0;font-weight:600;box-shadow:0 2rpx 6rpx #1f37510a}.search-box{display:flex;align-items:center;gap:12rpx;background:#f4f6fa;border-radius:16rpx;padding:0 22rpx;height:80rpx;box-sizing:border-box}.search-symbol{font-size:42rpx;color:#8d9bb1}.search-box input{flex:1;min-width:0;height:80rpx;font-size:25rpx}.search-placeholder{color:#98a4b7}.coupon-content{padding:0 24rpx}.filter-bar{display:flex;align-items:center;gap:26rpx;min-height:84rpx;flex-wrap:wrap;padding:10rpx 2rpx;box-sizing:border-box;color:#627089;font-size:23rpx}.result-total{margin-left:auto;color:#a0aabb;font-size:22rpx}.coupon-card{padding:26rpx;background:#fff;border:1rpx solid #e7ecf4;border-radius:22rpx;margin:0 0 20rpx;box-shadow:0 3rpx 10rpx #20375d03}.coupon-brand{color:#73829a;font-size:24rpx;max-width:85%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.coupon-title{font-size:29rpx;line-height:1.55;font-weight:600;margin:16rpx 0 22rpx;color:#26374f}.price{font-size:44rpx;line-height:1.2;font-weight:700;color:#306edb;margin:0 0 16rpx}.original{font-size:22rpx;color:#a2acbb;text-decoration:line-through;font-weight:400;margin-left:12rpx}.score-block{display:flex;flex-direction:column;align-items:flex-end;gap:3rpx}.score-number{font-size:32rpx;font-weight:650;color:#465878}.score-label{font-size:20rpx;color:#9aa5b6}.coupon-meta{display:flex;justify-content:space-between;color:#8895a9;font-size:22rpx;line-height:36rpx}.coupon-actions{display:flex;align-items:center;gap:18rpx;border-top:1rpx solid #f0f3f7;margin-top:20rpx;padding-top:20rpx}.coupon-actions button{margin:0;line-height:1.4;font-size:23rpx;padding:14rpx 22rpx;border-radius:12rpx}.coupon-actions .follow-brand{background:#edf3ff;color:#396bc1}.coupon-actions .mute-brand{background:transparent;color:#929dae;margin-left:auto;padding-right:0}.sheet-scroll{height:55vh}

.coupon-brand-heading{display:flex;align-items:center;gap:14rpx;flex:1;min-width:0}.brand-logo{width:60rpx;height:60rpx;flex-shrink:0;box-sizing:border-box;padding:4rpx;border:1rpx solid #edf0f5;border-radius:14rpx;background:#fff}.brand-logo-fallback{display:flex;align-items:center;justify-content:center;background:#edf3ff;color:#5275ac;font-size:26rpx;font-weight:600}.coupon-brand-heading .coupon-brand{max-width:none;flex:1;min-width:0;font-weight:500;color:#596d88}

.coupon-actions .is-added{background:#f1f4f8;color:#8995a7}.coupon-actions button[disabled]{opacity:.7}.coupon-actions button.is-added[disabled]{opacity:1}

.coupon-mode-filter{display:flex;align-items:center;gap:14rpx;padding:24rpx 0}.coupon-mode-caption{font-size:23rpx;color:#8b98ab;flex-shrink:0}.coupon-mode-options{display:flex;gap:10rpx;flex-wrap:wrap}.coupon-mode-option{position:relative;display:flex;align-items:center;justify-content:center;padding:13rpx 21rpx;border-radius:40rpx;background:#f2f5f9;border:1rpx solid transparent;font-size:24rpx;color:#65758b;line-height:32rpx}.coupon-mode-option.selected{background:#eaf1ff;border-color:#cfddfb;color:#326bd1;font-weight:600}.coupon-mode-radio{position:absolute;opacity:0;width:1rpx;height:1rpx;overflow:hidden}
