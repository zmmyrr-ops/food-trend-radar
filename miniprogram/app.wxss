page{background:#f5f7fb;color:#23344e;font-family:-apple-system,sans-serif;font-size:28rpx}.page{padding:28rpx 28rpx 48rpx}.title{font-size:42rpx;font-weight:700}.muted{color:#8591a4;font-size:24rpx;line-height:1.6}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.card{background:#fff;border:1rpx solid #e9edf4;border-radius:24rpx;padding:28rpx;margin-top:20rpx}.tabs{display:flex;gap:12rpx;margin:22rpx 0;white-space:nowrap}.chip{display:inline-block;padding:14rpx 22rpx;background:#edf1f8;border-radius:14rpx;font-size:25rpx;color:#75829a}.chip.active{background:#e8efff;color:#356ce0;font-weight:600}button{font-size:25rpx;line-height:1.5;padding:16rpx 22rpx;margin:0;border-radius:14rpx;background:#edf3ff;color:#356ce0}button::after{border:0}.primary{background:#356ce0;color:white}.search{background:#fff;border:1rpx solid #e4eaf3;padding:22rpx;border-radius:16rpx;margin:20rpx 0}.empty{text-align:center;padding:64rpx 20rpx;color:#8894a6}.badge{font-size:21rpx;background:#fff1e5;color:#d87a29;padding:5rpx 10rpx;border-radius:8rpx}.small{font-size:23rpx}.error{color:#c15656;padding:24rpx;background:#fff}.actions{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:24rpx}.heading{font-weight:600;font-size:30rpx}.divider{height:1rpx;background:#edf0f5;margin:22rpx 0}.modal{position:fixed;inset:0;background:#14233e66;display:flex;align-items:flex-end;z-index:10}.sheet{background:white;border-radius:28rpx 28rpx 0 0;max-height:80vh;width:100%;padding:28rpx;box-sizing:border-box;padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}.sheet-scroll{max-height:55vh}.rule{margin:20rpx 0;line-height:1.7}.link{color:#356ce0}
