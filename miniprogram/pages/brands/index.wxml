<view class="page"><view class="title">我的品牌</view><view class="muted">订阅好店，调整你的推荐偏好</view><view class="tabs"><view class="chip {{mode==='subscriptions'?'active':''}}" data-id="subscriptions" bindtap="switchMode">品牌订阅</view><view class="chip {{mode==='blacklist'?'active':''}}" data-id="blacklist" bindtap="switchMode">品牌黑名单</view></view>
<view wx:if="{{mode==='subscriptions'}}" class="card"><view class="heading">微信新商机提醒</view><view class="muted rule">有新上券或热度飙升时提醒你。需主动授权，微信可发送次数以实际授权为准。</view><button class="primary" bindtap="enable">开启一次微信提醒</button></view>
<input class="search" value="{{search}}" bindinput="search" placeholder="搜索品牌名或别名" maxlength="80" />
<view wx:if="{{search}}" class="card"><view wx:if="{{searching}}" class="muted">搜索中…</view><view wx:elif="{{!results.length}}" class="muted">暂无匹配品牌</view><view wx:for="{{results}}" wx:key="id" class="row rule"><text>{{item.name}}</text><button size="mini" disabled="{{busy||item.added}}" data-brand="{{item.id}}" data-add="yes" bindtap="change">{{item.added?'已添加':mode==='subscriptions'?'订阅':'拉黑'}}</button></view></view>
<view class="row rule"><text class="heading">{{mode==='subscriptions'?'已订阅':'已拉黑'}} · {{items.length}}</text></view><view wx:if="{{error}}" class="error" bindtap="retry">{{error}} · 重试</view><view wx:for="{{items}}" wx:key="brand_id" class="card row"><text>{{item.name}}</text><button size="mini" disabled="{{busy}}" data-brand="{{item.brand_id}}" data-add="no" bindtap="change">{{mode==='subscriptions'?'取消订阅':'移除'}}</button></view><view wx:if="{{loading}}" class="empty">加载中…</view><view wx:elif="{{!items.length&&!error}}" class="empty">尚未添加品牌</view></view>
